            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/settings/devices/{device}": {
      "parameters": [
        {
          "name": "device",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{8,64}$"
          }
        }
      ],
      "get": {
        "operationId": "getDevicePreferences",
        "responses": {
          "200": {
            "description": "Effective device preferences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePreferences"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveDevicePreferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePreferences"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved device preferences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePreferences"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Request forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_<host>"
      }
    },
    "schemas": {
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "spaceId",
          "name",
          "origin",
          "retention",
          "revisionMode",
          "defaults",
          "canWrite"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "spaceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "native"
            ]
          },
          "retention": {
            "type": "string",
            "enum": [
              "persistent"
            ]
          },
          "revisionMode": {
            "type": "string",
            "enum": [
              "managed",
              "repository",
              "disabled"
            ]
          },
          "defaults": {
            "type": "object",
            "required": [
              "outlineEnabled"
            ],
            "properties": {
              "outlineEnabled": {
                "type": "boolean"
              }
            }
          },
          "canWrite": {
            "type": "boolean"
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "path",
          "title",
          "outlineEnabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "outlineEnabled": {
            "type": "boolean"
          }
        }
      },
      "DocumentSnapshot": {
        "type": "object",
        "required": [
          "document",
          "markdown",
          "revision"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "markdown": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "WriteMarkdown": {
        "type": "object",
        "required": [
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "CreateDocument": {
        "type": "object",
        "required": [
          "path",
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": "null"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "currentRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "required": [
          "document",
          "excerpt"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "excerpt": {
            "type": "string"
          }
        }
      },
      "OutlineSnapshot": {
        "type": "object",
        "required": [
          "markdown",
          "revision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "SaveOutline": {
        "type": "object",
        "required": [
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "RevisionEntry": {
        "type": "object",
        "required": [
          "commitId",
          "timestamp",
          "author",
          "message",
          "added",
          "removed"
        ],
        "properties": {
          "commitId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "timestamp": {
            "type": "integer"
          },
          "author": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DocumentHistory": {
        "type": "object",
        "required": [
          "mode",
          "revisions",
          "uncommitted",
          "more"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "managed",
              "repository"
            ]
          },
          "revisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionEntry"
            }
          },
          "uncommitted": {
            "type": "boolean"
          },
          "more": {
            "type": "boolean"
          }
        }
      },
      "VersionDiff": {
        "type": "object",
        "required": [
          "commitId",
          "diff",
          "markdown"
        ],
        "properties": {
          "commitId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "diff": {
            "type": "string"
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RestoreRevision": {
        "type": "object",
        "required": [
          "commitId",
          "baseRevision"
        ],
        "properties": {
          "commitId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "baseRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "RestoredDocument": {
        "type": "object",
        "required": [
          "commitId",
          "snapshot"
        ],
        "properties": {
          "commitId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "snapshot": {
            "$ref": "#/components/schemas/DocumentSnapshot"
          }
        }
      },
      "DevicePreferences": {
        "type": "object",
        "required": [
          "theme",
          "font",
          "layout",
          "fontSize",
          "lineHeight",
          "measure",
          "navigation",
          "sidebarWidth",
          "toolsWidth",
          "eink",
          "reduceMotion",
          "focusKey"
        ],
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "font": {
            "type": "string",
            "enum": [
              "serif",
              "sans"
            ]
          },
          "layout": {
            "type": "string",
            "enum": [
              "reading",
              "writing",
              "research",
              "review",
              "custom"
            ]
          },
          "fontSize": {
            "type": "integer",
            "minimum": 16,
            "maximum": 28
          },
          "lineHeight": {
            "type": "number",
            "minimum": 1.4,
            "maximum": 2.4
          },
          "measure": {
            "type": "integer",
            "minimum": 28,
            "maximum": 56
          },
          "navigation": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sidebarWidth": {
            "type": "integer",
            "minimum": 176,
            "maximum": 360
          },
          "toolsWidth": {
            "type": "integer",
            "minimum": 200,
            "maximum": 480
          },
          "eink": {
            "type": "boolean"
          },
          "reduceMotion": {
            "type": "boolean"
          },
          "focusKey": {
            "type": "string",
            "pattern": "^[a-z]?$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
