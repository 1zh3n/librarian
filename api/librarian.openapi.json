  "components": {
    "securitySchemes": {
      "userToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_<host>"
      }
    },
    "schemas": {
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "spaceId",
          "name",
          "origin",
          "retention",
          "revisionMode",
          "defaults",
          "canWrite"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "spaceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "native"
            ]
          },
          "retention": {
            "type": "string",
            "enum": [
              "persistent"
            ]
          },
          "revisionMode": {
            "type": "string",
            "enum": [
              "managed",
              "repository",
              "disabled"
            ]
          },
          "defaults": {
            "type": "object",
            "required": [
              "outlineEnabled"
            ],
            "properties": {
              "outlineEnabled": {
                "type": "boolean"
              }
            }
          },
          "canWrite": {
            "type": "boolean"
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "path",
          "title",
          "outlineEnabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "outlineEnabled": {
            "type": "boolean"
          }
        }
      },
      "DocumentSnapshot": {
        "type": "object",
        "required": [
          "document",
          "markdown",
          "revision"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "markdown": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "WriteMarkdown": {
        "type": "object",
        "required": [
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "CreateDocument": {
        "type": "object",
        "required": [
          "path",
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": "null"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "currentRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "required": [
          "document",
          "excerpt"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "excerpt": {
            "type": "string"
          }
        }
      },
      "OutlineSnapshot": {
        "type": "object",
        "required": [
          "markdown",
          "revision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "SaveOutline": {
        "type": "object",
        "required": [
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "markdown": {
            "type": "string"
          },
          "baseRevision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
