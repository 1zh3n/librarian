# /etc/librarian/alert.env
# Read by librarian-monitor.service. Keep this file root-owned and mode 0600.
#
# POST failures as JSON to this URL. A local relay can translate the JSON for
# ntfy, Telegram, Discord, or email.
# ALERT_WEBHOOK_URL=https://ntfy.sh/librarian-example

# LIBRARIAN_PUBLIC_URL=https://librarian.zanghua.dev
# LIBRARIAN_LOCAL_URL=http://127.0.0.1:8080
# LIBRARIAN_BACKUP_DIR=/var/backups/librarian
# LIBRARIAN_DISK_MAX_PERCENT=85
# LIBRARIAN_MEMORY_MIN_MB=128
# LIBRARIAN_LOAD_MAX=4
# LIBRARIAN_CERT_MIN_DAYS=14
# LIBRARIAN_BACKUP_MAX_HOURS=30
