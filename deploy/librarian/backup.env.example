# /etc/librarian/backup.env
# Optional settings for librarian-backup.service and backup.sh.
#
# Local archives:
# LIBRARIAN_BACKUP_DIR=/var/backups/librarian
# LIBRARIAN_BACKUP_KEEP=14
#
# Offsite restic repository (install restic and place the password file at 0600):
# RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/librarian
# RESTIC_PASSWORD_FILE=/etc/librarian/restic-password
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
