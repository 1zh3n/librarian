# /etc/librarian/librarian.env
# Read by librarian.service. Keep this file root-owned and mode 0600.

# Keep MCP available but let the admin settings decide who can connect.
SB_MCP=1

# Trust X-Real-IP / X-Forwarded-For only from the loopback Caddy proxy.
LIBRARIAN_TRUST_LOOPBACK_PROXY=1

# Do not send the anonymous daily update check from a private deployment.
SB_UPDATE_CHECK=0

# Browser sessions expire after this many days.
SB_APP_TOKEN_EXPIRY_DAYS=30

RUST_LOG=info
