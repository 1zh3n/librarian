[Unit]
Description=Librarian
Documentation=file:/opt/librarian/current/docs/librarian/public-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=librarian
Group=librarian
WorkingDirectory=/var/lib/librarian
EnvironmentFile=/etc/librarian/librarian.env
ExecStart=/opt/librarian/current/librarian --data-root /var/lib/librarian/data --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
StateDirectory=librarian
StateDirectoryMode=0700
ReadWritePaths=/var/lib/librarian
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
